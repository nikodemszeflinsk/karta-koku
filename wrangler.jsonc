{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sushi-chef-lab",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sushi-chef-lab",
      // Production D1 (region WEUR). Local dev/tests use a local copy (Miniflare).
      "database_id": "d09aebcf-b03a-4a5b-a2b5-cbd5e9a0abae",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Production address. Local dev overrides it in .dev.vars (APP_URL=http://localhost:5173).
    "APP_URL": "https://kuchnia-formularze.nikodemszeflinsk.workers.dev",
    // Prototype mode: the Kitchen section (lists, handover, HACCP) works without signing in,
    // as a shared "Gość" account. Everything else still requires a login. Set to "false" to turn off.
    "OPEN_ACCESS": "true",
    // AI coach. The API key is a secret (wrangler secret put ANTHROPIC_API_KEY); without it AI stays off.
    "AI_ENABLED": "true",
    "AI_MODEL": "claude-sonnet-5-5",
    "AI_MODEL_LIGHT": "claude-haiku-5-5",
    "AI_EFFORT": "low",
    "AI_MAX_OUTPUT_TOKENS": "3000",
    "AI_MAX_CONTEXT_CHARS": "24000",
    "AI_RATE_PER_MINUTE": "6",
    "AI_DAILY_BUDGET_USD": "0.50",
    "AI_MONTHLY_BUDGET_USD": "5.00",
    // Empty = official Anthropic API. Only for local testing against a mock server.
    "AI_BASE_URL": ""
  }
}
