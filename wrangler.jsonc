{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sushi-chef-lab",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sushi-chef-lab",
      // Placeholder for local development. The real ID is set only after the
      // owner creates the database in Cloudflare (Stage 7).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_URL": "http://localhost:5173",
    // AI coach. The API key is a secret (wrangler secret put ANTHROPIC_API_KEY); without it AI stays off.
    "AI_ENABLED": "true",
    "AI_MODEL": "claude-sonnet-5-5",
    "AI_MODEL_LIGHT": "claude-haiku-5-5",
    "AI_EFFORT": "low",
    "AI_MAX_OUTPUT_TOKENS": "3000",
    "AI_MAX_CONTEXT_CHARS": "24000",
    "AI_RATE_PER_MINUTE": "6",
    "AI_DAILY_BUDGET_USD": "0.50",
    "AI_MONTHLY_BUDGET_USD": "5.00",
    // Empty = official Anthropic API. Only for local testing against a mock server.
    "AI_BASE_URL": ""
  }
}
