# Local origin (production APP_URL lives in wrangler.jsonc)
APP_URL=http://localhost:5173
# Copy to .dev.vars (ignored by git) and fill in locally. Never commit real values.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# One-time token required to create the owner account on /setup
SETUP_TOKEN=
# Anthropic API key for the AI coach (optional; AI is off without it). Never commit it.
ANTHROPIC_API_KEY=
